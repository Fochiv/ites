Options -Indexes

# The original uploaded logo copy is kept at the workspace root; serve its cropped
# website asset from assets/images/ites-logo.jpg instead.
<Files "logo_ites2.jpg">
  Require all denied
</Files>

# Do not expose repository metadata, imported prompts, or project configuration.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)(?:\.git|\.local|\.agents|\.cache|attached_assets)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
